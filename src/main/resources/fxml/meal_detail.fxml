<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.image.ImageView?>

<!-- Das Fxml File für die detailierte Ansich von Rezepten -->

<!-- Scroll Pane, macht das ganze Fenster Scrollable -->
<ScrollPane xmlns="http://javafx.com/javafx/8"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="view.MealDetailController"
            fitToWidth="true"
            hbarPolicy="NEVER"
            styleClass="page-scroll">

    <content>
        <VBox spacing="15" alignment="TOP_CENTER" styleClass="page-content">

            <!-- Padding -->
            <padding>
                <Insets top="20" right="20" bottom="20" left="20"/>
            </padding>

            <!-- Titel -->
            <Label fx:id="mealName"
                   styleClass="title"
                   wrapText="true"
                   maxWidth="500"
                   textAlignment="CENTER"
                   alignment="CENTER"/>

            <!-- Thumbnail -->
            <ImageView fx:id="mealImage"
                       fitWidth="300"
                       preserveRatio="true"/>

            <!-- Land Angabe -->
            <Label fx:id="mealCountry"/>

            <!-- Ingredients Liste -->
            <Label text="Ingredients"
                   styleClass="title"/>
            <ListView fx:id="ingredientList" VBox.vgrow="NEVER"/>

            <!-- Servings Control -->
            <HBox spacing="10" alignment="CENTER">
                <Button text="-" onAction="#decreaseServings"/>
                <Label text="Servings:"/>
                <Label fx:id="servingsLabel"/>
                <Button text="+" onAction="#increaseServings"/>
            </HBox>

            <!-- Instructions -->
            <Label text="Instructions"
                   styleClass="title"/>
            <Label fx:id="mealInstructions"
                   wrapText="true"
                   maxWidth="400"/>

            <!-- Back Button -->
            <Button text="Back" onAction="#goBack"/>

        </VBox>
    </content>

</ScrollPane>