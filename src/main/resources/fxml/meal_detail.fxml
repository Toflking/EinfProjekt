<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.image.ImageView?>

<!-- Das Fxml File für die detailierte Ansich von Rezepten -->

<!-- Scroll Pane, macht das ganze Fenster Scrollable -->
<ScrollPane xmlns="http://javafx.com/javafx/8"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="view.MealDetailController"
            fitToWidth="true"
            hbarPolicy="NEVER"
            styleClass="page-scroll">

    <VBox spacing="15" alignment="TOP_CENTER">

        <!-- Padding -->
        <padding>
            <Insets top="20" right="20" bottom="20" left="20"/>
        </padding>
        <StackPane>

            <!-- Back Button -->
            <HBox alignment="CENTER_LEFT"
                  pickOnBounds="false">
                <Button text="Back" onAction="#goBack"/>
            </HBox>

            <!-- Titel -->
            <Label fx:id="mealName"
                   styleClass="title"
                   wrapText="true"
                   maxWidth="500"
                   textAlignment="CENTER"
                   alignment="CENTER"
                   pickOnBounds="false"/>
            <HBox alignment="CENTER_RIGHT"
                  pickOnBounds="false">
                <!-- Herz für Favoriten -->
                <Label fx:id="heart"
                       styleClass="heart-outline"
                       text="♡"/>
            </HBox>

        </StackPane>
        <!-- Thumbnail -->
        <ImageView fx:id="mealImage"
                   fitWidth="300"
                   preserveRatio="true"/>

        <!-- Land Angabe -->
        <Label fx:id="mealCountry"/>

        <!-- Ingredients Liste -->
        <Label text="Ingredients"
               styleClass="title"/>
        <ListView fx:id="ingredientList" VBox.vgrow="NEVER"/>

        <!-- Servings Control -->
        <HBox spacing="10" alignment="CENTER">
            <Button text="-" onAction="#decreaseServings"/>
            <Label text="Servings:"/>
            <Label fx:id="servingsLabel"/>
            <Button text="+" onAction="#increaseServings"/>
        </HBox>

        <!-- Instructions -->
        <Label text="Instructions"
               styleClass="title"/>
        <Label fx:id="mealInstructions"
               wrapText="true"
               maxWidth="400"/>

        <!-- Video -->
        <Label fx:id="videoTitle"
               text="YouTube"
               styleClass="title"
               visible="false"
               managed="false"/>
        <Label fx:id="videoLabel"
               wrapText="true"
               maxWidth="480"
               visible="false"
               managed="false"
               alignment="CENTER"/>

        <!-- Source -->
        <Label fx:id="sourceTitle"
               text="Source"
               styleClass="title"
               visible="false"
               managed="false"
               alignment="CENTER"/>
        <Label fx:id="sourceLabel"
               wrapText="true"
               maxWidth="480"
               visible="false"
               managed="false"
               alignment="CENTER"/>

        <!-- Back Button -->
        <Button text="Back" onAction="#goBack"/>

    </VBox>
</ScrollPane>
