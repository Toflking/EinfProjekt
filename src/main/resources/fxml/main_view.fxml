<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>

<!-- Fxml File für den Main Controller -->

<VBox spacing="15"
      alignment="CENTER"
      xmlns="http://javafx.com/javafx/8"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="view.MainController">

    <!-- Padding hinzufügen -->
    <padding>
        <Insets top="20" right="20" bottom="20" left="20"/>
    </padding>

    <HBox spacing="10" alignment="CENTER_LEFT">
        <Button text="Create"
                onAction="#openCreateMeal"/>
        <Button text="Manage"
                onAction="#openManageMeals"/>

        <Region HBox.hgrow="ALWAYS"/>
        <!-- Anzeige des Usernamens -->
        <Label text="Logged in as:"/>
        <Label fx:id="usernameLabel"/>
        <!-- Settings und Logout Button -->
        <Button text="Settings" onAction="#openSettings"/>
        <Button text="Logout" onAction="#logout"/>

    </HBox>

    <!-- Titel -->
    <Label text="My Recipes"
           style="-fx-font-size:18px; -fx-font-weight:bold;"/>

    <!-- Search und Filter -->
    <ToolBar styleClass="filter-bar">
        <!-- Such Feld -->
        <TextField fx:id="searchField"
                   promptText="Search recipes..."
                   prefWidth="250"/>

        <!-- Filter nach Kategorie -->
        <ComboBox fx:id="categoryFilter"
                  promptText="Category"
                  prefWidth="80"/>

        <!-- Filter nach Land -->
        <ComboBox fx:id="areaFilter"
                  promptText="Category"
                  prefWidth="80"/>

        <Separator orientation="VERTICAL"/>

        <HBox alignment="CENTER_LEFT"
              spacing="8">
            <Label text="Favorites:"
                   styleClass="favorites-filter-label"/>
            <CheckBox fx:id="favoritesOnlyCheckBox" styleClass="filter-checkbox"/>
        </HBox>

    </ToolBar>
    <!-- Liste mit Meals -->
    <ListView fx:id="mealList"
              VBox.vgrow="ALWAYS"/>
    <!-- Refresh List Button -->
    <Button text="Refresh List"
            onAction="#runSearch"/>

</VBox>
